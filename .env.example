# Frontend Configuration
VITE_API_BASE_URL=/api

# Server Configuration
PORT=8787
NODE_ENV=development

# MongoDB Atlas Configuration
# Use solaris_dev as the development database
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/solaris_dev?retryWrites=true&w=majority"
MONGODB_DB_NAME="solaris_dev"

# Gemini AI API Configuration (server-only secret)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Single-process MVP data store fallback
SOLARIS_DATA_FILE="server/data/solaris.json"
SOLARIS_DEMO_HEADERS="false"
