# Frontend remains safe to expose only VITE_* public configuration.
VITE_API_BASE_URL=/api

# Server-only secret. Never prefix this with VITE_ and never commit a real value.
GEMINI_API_KEY=
# Verify credentials without printing them: npm run check:helios
PORT=8787
# Single-process persistent MVP data store. Back up this file; do not commit it.
SOLARIS_DATA_FILE=server/data/solaris.json
# Only for the legacy fixture API; leave false for normal use.
SOLARIS_DEMO_HEADERS=false
# Set NODE_ENV=production when serving the built frontend with the API.
GEMINI_MODEL=gemini-3.5-flash
